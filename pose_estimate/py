import cv2
import mediapipe as mp
import numpy as np
import math
import time

mp_drawing = mp.solutions.drawing_utils
mp_pose = mp.solutions.pose

def calculate_angle(a, b, c):
    # 3 nokta arasındaki açıyı hesaplar
    a = np.array(a)
    b = np.array(b)
    c = np.array(c)

    radians = np.arctan2(c[1]-b[1], c[0]-b[0]) - np.arctan2(a[1]-b[1], a[0]-b[0])
    angle = np.abs(radians*180.0/np.pi)

    if angle > 180.0:
        angle = 360 - angle
    return angle

# Sayaç ve durum
counter = 0
stage = None
min_angle_recorded = 180
max_angle_recorded = 0
bad_form_warnings = 0

# Video dosyası
cap = cv2.VideoCapture("shoulder_press.mp4")

# FPS ölçüm için zaman
prev_frame_time = 0

with mp_pose.Pose(min_detection_confidence=0.7, min_tracking_confidence=0.7) as pose:
    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            print("Video bitti.")
            break

        frame = cv2.resize(frame, (800, 600))
        image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        image.flags.writeable = False

        # Pose tespiti
        results = pose.process(image)

        image.flags.writeable = True
        image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

        try:
            landmarks = results.pose_landmarks.landmark

            # Sağ kol
            shoulder = [landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER.value].x,
                        landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER.value].y]
            elbow = [landmarks[mp_pose.PoseLandmark.RIGHT_ELBOW.value].x,
                     landmarks[mp_pose.PoseLandmark.RIGHT_ELBOW.value].y]
            wrist = [landmarks[mp_pose.PoseLandmark.RIGHT_WRIST.value].x,
                     landmarks[mp_pose.PoseLandmark.RIGHT_WRIST.value].y]

            angle = calculate_angle(shoulder, elbow, wrist)

            # Min-max güncelle
            if angle < min_angle_recorded:
                min_angle_recorded = angle
            if angle > max_angle_recorded:
                max_angle_recorded = angle

            # Hareket takibi
            if angle > 160:
                stage = "down"
            if angle < 70 and stage == 'down':
                stage = "up"
                counter += 1

            # Form değerlendirme
            shoulder_y = landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER.value].y
            wrist_y = landmarks[mp_pose.PoseLandmark.RIGHT_WRIST.value].y
            if stage == "up" and wrist_y > shoulder_y:
                bad_form_warnings += 1

            # Açı yazısı
            cv2.putText(image, str(int(angle)),
                        tuple(np.multiply(elbow, [800, 600]).astype(int)),
                        cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2, cv2.LINE_AA)

        except:
            pass

        # Grafiksel çizimler
        mp_drawing.draw_landmarks(
            image, results.pose_landmarks, mp_pose.POSE_CONNECTIONS,
            mp_drawing.DrawingSpec(color=(245,117,66), thickness=2, circle_radius=4),
            mp_drawing.DrawingSpec(color=(245,66,230), thickness=2, circle_radius=2)
        )

        # Sayaç ve diğer bilgiler
        cv2.rectangle(image, (0, 0), (250, 130), (0, 0, 0), -1)
        cv2.putText(image, f'Tekrar: {counter}', (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2)
        cv2.putText(image, f'Min Açı: {int(min_angle_recorded)}', (10, 60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 0), 2)
        cv2.putText(image, f'Max Açı: {int(max_angle_recorded)}', (10, 90),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 0), 2)
        cv2.putText(image, f'Hatalı Form: {bad_form_warnings}', (10, 120),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

        # FPS bilgisi
        new_frame_time = time.time()
        fps = 1/(new_frame_time - prev_frame_time) if prev_frame_time != 0 else 0
        prev_frame_time = new_frame_time
        cv2.putText(image, f'FPS: {int(fps)}', (650, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

        # Göster
        cv2.imshow('Shoulder Press Analyzer', image)

        if cv2.waitKey(10) & 0xFF == ord('q'):
            break

# Temizlik
cap.release()
cv2.destroyAllWindows()
